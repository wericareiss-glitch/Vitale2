# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MERCADO_PAGO_ACCESS_TOKEN: Your Mercado Pago Access Token (Test or Production)
# Obtain in Mercado Pago Developers > Suas Aplicações > Credenciais de Produção / Teste
# Starts with TEST- or APP_USR-
MERCADO_PAGO_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"

# MERCADO_PAGO_PUBLIC_KEY: Your Mercado Pago Public Key (optional for card tokenization)
MERCADO_PAGO_PUBLIC_KEY="TEST-00000000-0000-0000-0000-000000000000"
